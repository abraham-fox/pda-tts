# pda-tts config: copy to ~/.config/pda-tts/config and uncomment what you change.
# Plain bash assignments; quote values with spaces. Environment variables override this file.
#
#   ~/bin/pda-tts.sh --voices                     what this machine has installed
#   ~/bin/pda-tts.sh --say "Hello"                hear the current settings
#   ~/bin/pda-tts.sh --say "Hello" Notification   hear one event's settings
#   PDA_TTS_WIN_RATE=3 ~/bin/pda-tts.sh --say "Hello"   try a value without editing

# ============================================================================
# Engine: which speech engine talks
# ============================================================================
# auto     espeak-ng, then macOS say, then ~/pda/notify.wav, then Windows
# windows  Windows voices first (WSL); falls back to auto if PowerShell is missing or fails
#PDA_TTS_ENGINE=auto

# ============================================================================
# espeak-ng (Linux, WSL): used by ENGINE=auto, and as the fallback for windows
# ============================================================================
# Voice: <language>+<variant>. Run --voices for the full lists.
#   English languages: en-us, en-gb, en-gb-scotland, en-gb-x-rp, en-us-nyc, en-029 (Caribbean)
#   Variants: f1..f5 (female), m1..m8 (male), klatt..klatt6 (retro synth),
#             whisper, whisperf, croak, Annie, Andy, edward, grandma, robosoft..robosoft8
#PDA_TTS_ESPEAK_VOICE=en-us+f4
# Speed in words per minute: 80 to 450 (espeak default 175)
#PDA_TTS_ESPEAK_SPEED=180
# Pitch: 0 to 99 (espeak default 50; anything above 99 sounds like 99)
#PDA_TTS_ESPEAK_PITCH=120
# Volume: 0 to 200
#PDA_TTS_ESPEAK_VOLUME=100

# ============================================================================
# Windows voices (WSL): used by ENGINE=windows
# ============================================================================
# Voice: exact name from --voices, e.g. "Microsoft Zira Desktop" (female),
# "Microsoft David Desktop" (male). An unknown name keeps the system default voice.
#PDA_TTS_WIN_VOICE="Microsoft Zira Desktop"
# Speed: -10 (slow) to 10 (fast)
#PDA_TTS_WIN_RATE=0
# Volume: 0 to 100
#PDA_TTS_WIN_VOLUME=100

# ============================================================================
# Per-event overrides
# ============================================================================
# Every setting above takes an event suffix: _STOP (task finished), _NOTIFICATION
# (needs input or permission), _SESSIONSTART (session opened). The suffixed setting
# wins for that event; other events use the general one.
#PDA_TTS_WIN_VOICE_NOTIFICATION="Microsoft David Desktop"
#PDA_TTS_WIN_RATE_STOP=1
#PDA_TTS_ENGINE_SESSIONSTART=auto
#PDA_TTS_ESPEAK_VOICE_SESSIONSTART=en-us+klatt

# ============================================================================
# What Stop says
# ============================================================================
# status:  "<who>: <state>." with state done, has a question, needs a decision, blocked or failed
# summary: "<who>: <one-line summary of the final reply>"
# <who> is the session name (claude -n, /rename), else the project and the branch as words
#PDA_TTS_STOP_STYLE=status
# Model that reads the final reply; "off" skips it: the state is "has a question" when the
# reply ends with a question mark, else "done" (the summary style speaks its first sentence)
#PDA_TTS_SUMMARY_MODEL=haiku
# Seconds to wait for the model before falling back
#PDA_TTS_SUMMARY_TIMEOUT=15

# ============================================================================
# Other
# ============================================================================
# Silence everything (a cron job can export it for its own sessions only)
#PDA_TTS_MUTE=1
# Log file, and the size in bytes past which it is cut to its newer half
#PDA_TTS_LOG=~/claude-hooks.log
#PDA_TTS_LOG_MAX_BYTES=262144
